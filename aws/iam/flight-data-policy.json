{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:767397924129:secret:flight/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:767397924129:table/subscriptions",
        "arn:aws:dynamodb:us-east-1:767397924129:table/notification_history",
        "arn:aws:dynamodb:us-east-1:767397924129:table/radar_videos"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::flight-config-767397924129/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:GetQueueUrl",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:767397924129:flight-fare-queue",
        "arn:aws:sqs:us-east-1:767397924129:flight-status-queue",
        "arn:aws:sqs:us-east-1:767397924129:radar-alert-queue"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:us-east-1:767397924129:function:flight-parser",
        "arn:aws:lambda:us-east-1:767397924129:function:radar-scan"
      ]
    }
  ]
}